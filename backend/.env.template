# CakeToHome Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Database
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/caketohome

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Secrets (REQUIRED - generate secure random strings)
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET
COOKIE_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET

# CORS
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000

# Backend URL
BACKEND_URL=http://localhost:9000