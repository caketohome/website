# CakeToHome Medusa v2 Backend Environment Example
# Copy to backend/.env and fill in real values. NEVER commit .env files.

# Database (PostgreSQL 16+ with UTF8 encoding)
# - For Supabase, use the Session Pooler (port 5432), NOT Transaction Pooler (port 6543),
#   because Medusa v2 / MikroORM uses prepared statements:
#   DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# - For isolated local Medusa development (separate from ERP rehearsal DB):
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@127.0.0.1:5433/cth_medusa

# Frontend & CORS
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:9000
STORE_CORS=http://localhost:3000,http://localhost:7001,http://localhost:9000
ADMIN_CORS=http://localhost:7001,http://localhost:9000,http://localhost:3000
AUTH_CORS=http://localhost:3000,http://localhost:7001,http://localhost:9000
DISABLE_MEDUSA_ADMIN=true

# Security Secrets (REQUIRED - generate strong random strings for non-local use)
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET
COOKIE_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET

# Supabase (Project Metadata)
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<SUPABASE_PUBLISHABLE_OR_ANON_KEY>

# Redis (Event Bus & Workflow Engine)
REDIS_URL=rediss://default:<REDIS_PASSWORD>@<REDIS_HOST>:6379

# Optional AWS S3 File Storage
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET_NAME=<BUCKET_NAME>
# AWS_ACCESS_KEY_ID=<ACCESS_KEY_ID>
# AWS_SECRET_ACCESS_KEY=<SECRET_ACCESS_KEY>

