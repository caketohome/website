  "accounting_voucher_constraints": [
    {
      "conname": "accounting_voucher_branch_id_fkey",
      "def": "FOREIGN KEY (branch_id) REFERENCES branch(id) ON DELETE RESTRICT"
    },
    {
      "conname": "accounting_voucher_pkey",
      "def": "PRIMARY KEY (id)"
    },
    {
      "conname": "accounting_voucher_reversal_of_voucher_id_fkey",
      "def": "FOREIGN KEY (reversal_of_voucher_id) REFERENCES accounting_voucher(id) ON DELETE SET NULL"
    },
    {
      "conname": "accounting_voucher_reversed_by_voucher_id_fkey",
      "def": "FOREIGN KEY (reversed_by_voucher_id) REFERENCES accounting_voucher(id) ON DELETE SET NULL"
    },
    {
      "conname": "chk_voucher_posted_immutable",
      "def": "CHECK ((((status)::text <> 'CANCELLED'::text) OR (posted_at IS NULL)))"
    },
    {
      "conname": "chk_voucher_reversal_limit",
      "def": "CHECK (((reversal_of_voucher_id IS NULL) OR (reversed_by_voucher_id IS NULL)))"
    },
    {
      "conname": "chk_voucher_segregation",
      "def": "CHECK (((approved_by IS NULL) OR (approved_by <> created_by)))"
    },
    {
      "conname": "chk_voucher_status",
      "def": "CHECK (((status)::text = ANY ((ARRAY['DRAFT'::character varying, 'SUBMITTED'::character varying, 'APPROVED'::character varying, 'POSTED'::character varying, 'CANCELLED'::character varying])::text[])))"
    },
    {
      "conname": "chk_voucher_total",
      "def": "CHECK ((total_amount >= 0.00))"
    },
    {
      "conname": "chk_voucher_type",
      "def": "CHECK (((voucher_type)::text = ANY ((ARRAY['SALES'::character varying, 'PURCHASE'::character varying, 'PAYMENT'::character varying, 'RECEIPT'::character varying, 'EXPENSE'::character varying, 'JOURNAL'::character varying, 'CONTRA'::character varying, 'CREDIT_NOTE'::character varying, 'DEBIT_NOTE'::character varying, 'OPENING_BALANCE'::character varying])::text[])))"
    },
    {
      "conname": "uq_accounting_voucher_no",
      "def": "UNIQUE (voucher_no)"
    }
  ]
