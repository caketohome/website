  "check_constraints": [
    {
      "table_name": "corporate_account",
      "constraint_name": "chk_ca_gstin",
      "definition": "CHECK (((gstin IS NULL) OR ((gstin)::text ~ '^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$'::text)))"
    },
    {
      "table_name": "corporate_account",
      "constraint_name": "chk_ca_pan",
      "definition": "CHECK (((pan IS NULL) OR ((pan)::text ~ '^[A-Z]{5}[0-9]{4}[A-Z]{1}$'::text)))"
    },
    {
      "table_name": "corporate_account",
      "constraint_name": "chk_ca_pan_gstin_match",
      "definition": "CHECK (((gstin IS NULL) OR (pan IS NULL) OR (SUBSTRING(gstin FROM 3 FOR 10) = (pan)::text)))"
    },
    {
      "table_name": "corporate_account",
      "constraint_name": "corporate_account_credit_requested_limit_check",
      "definition": "CHECK (((credit_requested_limit IS NULL) OR (credit_requested_limit >= 0.00)))"
    },
    {
      "table_name": "corporate_account",
      "constraint_name": "corporate_account_credit_requested_terms_days_check",
      "definition": "CHECK (((credit_requested_terms_days IS NULL) OR (credit_requested_terms_days >= 0)))"
    },
    {
      "table_name": "corporate_account",
