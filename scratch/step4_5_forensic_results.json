  "voucher_type_constraint": [
    {
      "conname": "chk_voucher_type",
      "def": "CHECK (((voucher_type)::text = ANY ((ARRAY['SALES'::character varying, 'PURCHASE'::character varying, 'PAYMENT'::character varying, 'RECEIPT'::character varying, 'EXPENSE'::character varying, 'JOURNAL'::character varying, 'CONTRA'::character varying, 'CREDIT_NOTE'::character varying, 'DEBIT_NOTE'::character varying, 'OPENING_BALANCE'::character varying])::text[])))"
    }
  ],
  "journal_entry_constraints": [
    {
      "conname": "accounting_journal_entry_branch_id_fkey",
      "def": "FOREIGN KEY (branch_id) REFERENCES branch(id) ON DELETE RESTRICT"
    },
    {
      "conname": "accounting_journal_entry_pkey",
      "def": "PRIMARY KEY (id)"
    },
    {
      "conname": "accounting_journal_entry_voucher_id_fkey",
      "def": "FOREIGN KEY (voucher_id) REFERENCES accounting_voucher(id) ON DELETE RESTRICT"
    },
    {
      "conname": "accounting_journal_entry_voucher_id_key",
      "def": "UNIQUE (voucher_id)"
    },
    {
      "conname": "chk_journal_balanced",
      "def": "CHECK ((total_debit = total_credit))"
    },
    {
      "conname": "chk_journal_positive",
      "def": "CHECK ((total_debit > 0.00))"
    },
    {
      "conname": "uq_accounting_journal_entry_no",
      "def": "UNIQUE (entry_no)"
    }
  ],
  "journal_line_constraints": [
    {
      "conname": "accounting_journal_line_account_id_fkey",
      "def": "FOREIGN KEY (account_id) REFERENCES accounting_account(id) ON DELETE RESTRICT"
    },
    {
      "conname": "accounting_journal_line_branch_id_fkey",
      "def": "FOREIGN KEY (branch_id) REFERENCES branch(id) ON DELETE RESTRICT"
    },
    {
      "conname": "accounting_journal_line_customer_id_fkey",
      "def": "FOREIGN KEY (customer_id) REFERENCES customer(id) ON DELETE RESTRICT"
    },
    {
      "conname": "accounting_journal_line_journal_entry_id_fkey",
      "def": "FOREIGN KEY (journal_entry_id) REFERENCES accounting_journal_entry(id) ON DELETE RESTRICT"
    },
    {
      "conname": "accounting_journal_line_pkey",
      "def": "PRIMARY KEY (id)"
    },
    {
      "conname": "accounting_journal_line_supplier_id_fkey",
      "def": "FOREIGN KEY (supplier_id) REFERENCES supplier(id) ON DELETE RESTRICT"
    },
    {
      "conname": "chk_jline_credit_nonneg",
      "def": "CHECK ((credit_amount >= 0.00))"
    },
    {
      "conname": "chk_jline_debit_nonneg",
      "def": "CHECK ((debit_amount >= 0.00))"
    },
    {
      "conname": "chk_jline_single_sided",
      "def": "CHECK ((((debit_amount > 0.00) AND (credit_amount = 0.00)) OR ((credit_amount > 0.00) AND (debit_amount = 0.00))))"
    },
    {
      "conname": "trg_check_journal_balance",
      "def": "TRIGGER DEFERRABLE INITIALLY DEFERRED"
    },
    {
      "conname": "uq_journal_line_order",
      "def": "UNIQUE (journal_entry_id, line_no)"
    }
  ],
